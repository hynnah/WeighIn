<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="0,0,0,28" Spacing="18">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout.Background>
                        <RadialGradientBrush Center="0.5,0" Radius="0.9">
                            <GradientStop Color="{AppThemeBinding Light=#F6F4EE, Dark=#20233A}" Offset="0.0" />
                            <GradientStop Color="{AppThemeBinding Light=#F6F4EE, Dark=#161826}" Offset="0.62" />
                        </RadialGradientBrush>
                    </VerticalStackLayout.Background>
                    <Grid Padding="20,10,20,0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label x:Name="DateEyebrowLabel" Text="FRI 28 AUGUST" FontSize="10" CharacterSpacing="1.4" TextColor="#9184D9" />
                            <Label x:Name="GreetingLabel" Text="Morning, Hannah" FontSize="21" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" BackgroundColor="Transparent" StrokeShape="RoundRectangle 17" HorizontalOptions="End" VerticalOptions="Start">
                            <GraphicsView x:Name="SettingsIcon" WidthRequest="17" HeightRequest="17" InputTransparent="True" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMoreClicked" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                    <Grid HeightRequest="164" Margin="0,2,0,0">
                        <GraphicsView x:Name="GaugeGraphic" WidthRequest="252" HeightRequest="164" HorizontalOptions="Center" VerticalOptions="Start" />
                        <VerticalStackLayout x:Name="GaugeReadoutStack" Spacing="2" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,66,0,0">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="CurrentWeightLabel" Text="52.65" FontSize="38" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                                <Label x:Name="CurrentUnitLabel" Text="kg" FontSize="15" VerticalOptions="End" Margin="0,0,0,4" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            </HorizontalStackLayout>
                            <Label x:Name="CurrentBmiLabel" FontSize="12" HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span x:Name="BmiValueSpan" Text="BMI 17.6 · " TextColor="{AppThemeBinding Light=#5C5F6E, Dark=#9397AB}" />
                                        <Span x:Name="BmiCategorySpan" Text="Underweight" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label x:Name="ToNormalLabel" Text="Asian standard · in the healthy band" FontSize="10" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid x:Name="WeekStripGrid" Padding="22,2,22,0" ColumnDefinitions="*,*,*,*,*,*,*" />
                </VerticalStackLayout>
                <VerticalStackLayout Padding="24,0,24,0" Spacing="18">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SINCE LAST" FontSize="10" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            <Label x:Name="DeltaSinceLastLabel" Text="—" FontSize="18" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SINCE START" FontSize="10" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            <Label x:Name="DeltaSinceStartLabel" Text="—" FontSize="18" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="LAST 30 DAYS" FontSize="11" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                        <Label x:Name="WeeklyRateLabel" Grid.Column="1" Text="—" FontSize="13" TextColor="{AppThemeBinding Light=#477361, Dark=#B5ABFC}" />
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="{AppThemeBinding Light=#E7E3DC, Dark=#2C2F3D}" Margin="0,14" />
                        <Label x:Name="TrendStartLabel" Grid.Row="2" Text="" FontSize="11" TextColor="{AppThemeBinding Light=#9C9990, Dark=#75798C}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Today" FontSize="11" TextColor="{AppThemeBinding Light=#9C9990, Dark=#75798C}" />
                        <GraphicsView x:Name="TrendGraph" Grid.Row="3" Grid.ColumnSpan="2" HeightRequest="54" Margin="0,2" />
                    </Grid>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#EEEAE0, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=Transparent, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="GOAL" FontSize="11" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#817D72, Dark=#9397AB}" />
                        <Label x:Name="GoalPercentLabel" Grid.Column="1" Text="" FontSize="15" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Label x:Name="GoalSummaryLabel" Grid.Row="1" Text="Set a weight goal" FontSize="19" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" Margin="0,6,0,10" />
                        <ProgressBar x:Name="GoalProgressBar" Grid.Row="2" Grid.ColumnSpan="2" Progress="0" ProgressColor="#9184D9" BackgroundColor="{AppThemeBinding Light=#B7B4B0, Dark=#3F424D}" HeightRequest="7" />
                        <Label x:Name="GoalEtaLabel" Grid.Row="3" Grid.ColumnSpan="2" Text="Tap to choose a target weight and date." FontSize="12" TextColor="{AppThemeBinding Light=#817D72, Dark=#75798C}" Margin="0,10,0,0" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalCardTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="26 WEEKS" FontSize="11" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                        <GraphicsView x:Name="ContributionGraphic" HeightRequest="80" />
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" BackgroundColor="Transparent" Color="{AppThemeBinding Light=#E4E1D8, Dark=#232532}" />
                            <Label Text="missed" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" VerticalOptions="Center" />
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" BackgroundColor="Transparent" Color="#8878D6" Margin="10,0,0,0" />
                            <Label Text="logged" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"><VerticalStackLayout Spacing="5"><Label x:Name="WeeksTrackingLabel" Text="0 weeks" FontSize="20" TextColor="{AppThemeBinding Light=#183332, Dark=#E9E9ED}" /><Label Text="tracking" FontSize="12" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"><VerticalStackLayout Spacing="5"><Label x:Name="StreakLabel" Text="0 days" FontSize="20" TextColor="{AppThemeBinding Light=#183332, Dark=#E9E9ED}" /><Label Text="current streak" FontSize="12" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" /></VerticalStackLayout></Border>
                </Grid>
            </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Padding="12,14,12,20" ColumnDefinitions="*,*,76,*,*">
            <Grid HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="HomeIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="HomeLabel" Text="Home" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="1" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="TrendsIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="TrendsLabel" Text="Trends" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTrendsClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="3" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="CalendarIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="CalendarLabel" Text="Calendar" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="4" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="MoreIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="MoreLabel" Text="More" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreClicked" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>
        <Border Grid.Row="1" WidthRequest="64" HeightRequest="64" Margin="0,0,0,46" HorizontalOptions="Center" VerticalOptions="End" StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="#9184D9">
            <Border.Shadow>
                <Shadow Brush="#9184D9" Radius="18" Opacity="0.55" Offset="0,4" />
            </Border.Shadow>
            <GraphicsView x:Name="AddIcon" WidthRequest="64" HeightRequest="64" InputTransparent="True" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddClicked" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>
