<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.ReminderSettingsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,18,24,12" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="APP" FontSize="10" CharacterSpacing="2.5" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                <Label Text="Daily reminder" FontSize="24" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="×" FontSize="28" WidthRequest="40" HeightRequest="40" Padding="0" TextColor="#9184D9" BackgroundColor="Transparent" Clicked="OnCloseClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                    <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                        <Label Text="Daily reminder" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Switch x:Name="ReminderSwitch" Grid.Column="1" Toggled="OnReminderToggled" OnColor="#9184D9" />
                    </Grid>
                </Border>

                <Border x:Name="TimeRow" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                    <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                        <Label Text="Reminder time" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Grid Grid.Column="1">
                            <!-- MAUI's Android TimePicker doesn't render its own summary text in this SDK version, so a Label overlays it. -->
                            <TimePicker x:Name="ReminderTimePicker" Format="hh:mm tt" TimeSelected="OnReminderTimeSelected" TextColor="Transparent" BackgroundColor="Transparent" />
                            <Label x:Name="ReminderTimeDisplayLabel" FontSize="15" TextColor="#9184D9" HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                        </Grid>
                    </Grid>
                </Border>

                <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="#9184D9" TextColor="White" CornerRadius="10" HeightRequest="48" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
