<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.CalendarPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label x:Name="TitleLabel" Text="Calendar" Padding="24,20,24,0" FontSize="20" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,14,24,32" Spacing="16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Text="‹" FontSize="20" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" Clicked="OnPreviousMonthClicked" />
                    <Label x:Name="MonthLabel" Grid.Column="1" Text="September 2026" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                    <Button Grid.Column="2" Text="›" FontSize="20" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" Clicked="OnNextMonthClicked" />
                </Grid>
                <Grid x:Name="WeekdayHeaderGrid" ColumnDefinitions="*,*,*,*,*,*,*" />
                <Grid x:Name="DaysGrid" RowSpacing="4" ColumnSpacing="4" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="SelectedDateLabel" Text="Select a day" FontSize="15" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Label x:Name="SelectedWeightLabel" Text="" FontSize="13" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        <Button x:Name="LogSelectedDayButton" Text="Log this day" Clicked="OnLogSelectedDayClicked" BackgroundColor="#9184D9" TextColor="White" CornerRadius="10" HeightRequest="44" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Padding="18,14,18,20" ColumnDefinitions="*,*,*,*,*">
            <GraphicsView x:Name="HomeIcon" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
            <GraphicsView x:Name="TrendsIcon" Grid.Column="1" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTrendsClicked" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
            <GraphicsView x:Name="AddIcon" Grid.Column="2" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddClicked" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
            <GraphicsView x:Name="CalendarIcon" Grid.Column="3" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarClicked" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
            <GraphicsView x:Name="MoreIcon" Grid.Column="4" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreClicked" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
        </Grid>
    </Grid>
</ContentPage>
