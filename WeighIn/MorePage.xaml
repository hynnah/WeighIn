<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.MorePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Text="More" Padding="24,20,24,0" FontSize="20" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,14,24,28" Spacing="20">
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light=#EDE9F9, Dark=#3A3266}">
                            <Label x:Name="AvatarInitialLabel" Text="?" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#4A3E8C, Dark=#D8D2FF}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="NameLabel" Text="" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label x:Name="ProfileSummaryLabel" Text="" FontSize="12" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="YOUR DATA" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.6" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                            <Label Text="History" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label Grid.Column="1" Text="›" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="24">
                            <Label Text="Goal" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label x:Name="GoalSummaryLabel" Grid.Column="1" Text="" FontSize="11" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,8,0" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            <Label Grid.Column="2" Text="›" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="24">
                            <Label Text="Waist &amp; hips" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label x:Name="WaistHipsSummaryLabel" Grid.Column="1" Text="" FontSize="11" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,8,0" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            <Label Grid.Column="2" Text="›" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWaistHipsTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="APP" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.6" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                            <Label Text="Dark mode" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Switch x:Name="DarkModeSwitch" Grid.Column="1" Toggled="OnDarkModeToggled" OnColor="#9184D9" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                            <Label Text="Daily reminder" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3" BackgroundColor="{AppThemeBinding Light=#EDEAE2, Dark=#2C2F3D}" VerticalOptions="Center">
                                <Label x:Name="ReminderTagLabel" Text="Off" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            </Border>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReminderRowTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                            <Label Text="App lock" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3" BackgroundColor="{AppThemeBinding Light=#EDEAE2, Dark=#2C2F3D}" VerticalOptions="Center">
                                <Label x:Name="LockTagLabel" Text="Off" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            </Border>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppLockRowTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="24">
                            <Label Text="Export / import CSV" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label Grid.Column="1" Text="›" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExportImportTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4" Margin="4,4,4,0">
                    <Label Text="Everything stays on this phone. No account, no network." FontSize="11" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="18" Margin="4,2,4,0">
                    <Label x:Name="LockNowLabel" Text="Lock now" FontSize="11" TextColor="#9184D9">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLockNowTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Padding="12,14,12,20" ColumnDefinitions="*,*,76,*,*">
            <Grid HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="HomeIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="HomeLabel" Text="Home" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="1" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="TrendsIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="TrendsLabel" Text="Trends" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTrendsClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="3" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="CalendarIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="CalendarLabel" Text="Calendar" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="4" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="MoreIcon" WidthRequest="24" HeightRequest="24" InputTransparent="True" />
                    <Label x:Name="MoreLabel" Text="More" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreClicked" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>
        <Border Grid.Row="2" WidthRequest="64" HeightRequest="64" Margin="0,0,0,46" HorizontalOptions="Center" VerticalOptions="End" StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="#9184D9">
            <Border.Shadow>
                <Shadow Brush="#9184D9" Radius="18" Opacity="0.55" Offset="0,4" />
            </Border.Shadow>
            <GraphicsView x:Name="AddIcon" WidthRequest="64" HeightRequest="64" InputTransparent="True" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddClicked" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>
