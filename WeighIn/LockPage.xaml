<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.LockPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#283B35">
    <Grid RowDefinitions="*,Auto,Auto,*" Padding="32,40">
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="10">
            <Label Text="WeighIn" FontSize="42" FontAttributes="Bold" TextColor="#F4F0E8" HorizontalOptions="Center" />
            <Label Text="weigh in with intention" FontSize="12" CharacterSpacing="2" TextColor="#B9C9BC" HorizontalOptions="Center" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2" Spacing="16" Margin="0,44,0,0">
            <Label Text="Enter your PIN" FontSize="16" TextColor="#F4F0E8" HorizontalOptions="Center" />
            <Label x:Name="PinStatus" Text="" FontSize="12" TextColor="#E29A5F" HorizontalOptions="Center" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" HorizontalOptions="Center">
                <BoxView x:Name="Dot1" WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="#B9C9BC" />
                <BoxView x:Name="Dot2" Grid.Column="1" WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="#B9C9BC" />
                <BoxView x:Name="Dot3" Grid.Column="2" WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="#B9C9BC" />
                <BoxView x:Name="Dot4" Grid.Column="3" WidthRequest="12" HeightRequest="12" CornerRadius="6" Color="#B9C9BC" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="14" Margin="0,8,0,0">
                <Button Text="1" Clicked="OnDigitClicked" CommandParameter="1" Style="{StaticResource PinButton}" />
                <Button Grid.Column="1" Text="2" Clicked="OnDigitClicked" CommandParameter="2" Style="{StaticResource PinButton}" />
                <Button Grid.Column="2" Text="3" Clicked="OnDigitClicked" CommandParameter="3" Style="{StaticResource PinButton}" />
                <Button Grid.Row="1" Text="4" Clicked="OnDigitClicked" CommandParameter="4" Style="{StaticResource PinButton}" />
                <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnDigitClicked" CommandParameter="5" Style="{StaticResource PinButton}" />
                <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnDigitClicked" CommandParameter="6" Style="{StaticResource PinButton}" />
                <Button Grid.Row="2" Text="7" Clicked="OnDigitClicked" CommandParameter="7" Style="{StaticResource PinButton}" />
                <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnDigitClicked" CommandParameter="8" Style="{StaticResource PinButton}" />
                <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnDigitClicked" CommandParameter="9" Style="{StaticResource PinButton}" />
                <Button Grid.Row="3" Grid.Column="1" Text="0" Clicked="OnDigitClicked" CommandParameter="0" Style="{StaticResource PinButton}" />
                <Button Grid.Row="3" Grid.Column="2" Text="⌫" Clicked="OnDeleteClicked" Style="{StaticResource PinButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>