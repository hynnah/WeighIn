<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WeighIn.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WeighIn"
    Title="WeighIn">

    <ShellContent
        Title="Unlock"
        ContentTemplate="{DataTemplate local:LockPage}"
        Route="lock" />

    <TabBar Route="main" Shell.TabBarIsVisible="False">
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="home" />
        <ShellContent Title="Trends" ContentTemplate="{DataTemplate local:TrendsPage}" Route="trends" />
        <ShellContent Title="Calendar" ContentTemplate="{DataTemplate local:CalendarPage}" Route="calendar" />
        <ShellContent Title="More" ContentTemplate="{DataTemplate local:MorePage}" Route="more" />
    </TabBar>

</Shell>
