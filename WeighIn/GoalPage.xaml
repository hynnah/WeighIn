<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.GoalPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,18,20,0" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="22" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" Clicked="OnCloseClicked" />
            <Label Grid.Column="1" Text="Goal" FontSize="21" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,12,24,28" Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeShape="RoundRectangle 22" BackgroundColor="Transparent">
                        <Label Text="−" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalDownTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label x:Name="GoalWeightLabel" FontSize="46" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Label x:Name="GoalUnitLabel" FontSize="17" VerticalOptions="End" Margin="0,0,0,8" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeShape="RoundRectangle 22" BackgroundColor="Transparent">
                        <Label Text="+" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalUpTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
                <Label x:Name="GoalDeltaLabel" FontSize="12" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />

                <Label Text="TARGET DATE" FontSize="10" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" Margin="0,10,0,0" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="DateChipsStack" Spacing="7" />
                </ScrollView>

                <Border BackgroundColor="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="1" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="1">
                        <VerticalStackLayout BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}" Padding="13,11" Spacing="2">
                            <Label Text="NEEDED PACE" FontSize="9" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            <HorizontalStackLayout Spacing="4">
                                <Label x:Name="NeededPaceLabel" FontSize="19" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                                <Label x:Name="NeededPaceUnitLabel" FontSize="11" VerticalOptions="End" Margin="0,0,0,3" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}" Padding="13,11" Spacing="2">
                            <Label Text="YOUR PACE NOW" FontSize="9" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            <HorizontalStackLayout Spacing="4">
                                <Label x:Name="CurrentPaceLabel" FontSize="19" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                                <Label x:Name="CurrentPaceUnitLabel" FontSize="11" VerticalOptions="End" Margin="0,0,0,3" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#EDE9F9, Dark=#231F3D}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="13,11">
                    <Label x:Name="VerdictLabel" FontSize="12" LineBreakMode="WordWrap" />
                </Border>

                <Button Text="Save goal" Clicked="OnSaveClicked" BackgroundColor="#9184D9" TextColor="#161826" CornerRadius="10" HeightRequest="46" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
