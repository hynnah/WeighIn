<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.HistoryPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid Padding="20,18,20,0" ColumnDefinitions="Auto,*,Auto">
            <Button Text="‹" FontSize="22" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" Clicked="OnCloseClicked" />
            <Label Grid.Column="1" Text="History" FontSize="21" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
            <Label x:Name="CountLabel" Grid.Column="2" FontSize="11" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
        </Grid>

        <Border Grid.Row="1" Margin="20,14,20,0" Padding="11,8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
            <Entry x:Name="SearchEntry" Placeholder="Search notes and dates" FontSize="13" TextChanged="OnSearchChanged" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" PlaceholderColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" BackgroundColor="Transparent" />
        </Border>

        <Grid x:Name="FilterChipsGrid" Grid.Row="2" Margin="20,11,20,0" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7" />

        <Grid Grid.Row="3" Margin="20,16,20,6" ColumnDefinitions="*,Auto">
            <Label x:Name="SectionHeadLabel" FontSize="10" CharacterSpacing="1.1" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
            <Label x:Name="SectionAvgLabel" Grid.Column="1" FontSize="10" CharacterSpacing="1.1" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
        </Grid>

        <CollectionView Grid.Row="4" x:Name="RowsView" Margin="20,0,20,20">
            <CollectionView.EmptyView>
                <Label Text="No entries match" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,9" ColumnDefinitions="34,*,Auto" Opacity="{Binding Opacity}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding DayNumber}" FontSize="15" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label Text="{Binding DayOfWeek}" FontSize="9" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,8,0">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding WeightText}" FontSize="15" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                                <Label Text="{Binding MetaText}" FontSize="11" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding NoteText}" FontSize="11" FontAttributes="{Binding NoteStyle}" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="0" HorizontalOptions="End">
                            <Label Text="{Binding BmiText}" FontSize="13" TextColor="{Binding BmiColor}" HorizontalTextAlignment="End" />
                            <Label Text="{Binding BmiLabel}" FontSize="9" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" />
                        </VerticalStackLayout>
                        <BoxView Grid.ColumnSpan="3" VerticalOptions="End" HeightRequest="1" Color="{AppThemeBinding Light=#E7E3DC, Dark=#2C2F3D}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
