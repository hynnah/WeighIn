<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F6F4EE, Dark=#161826}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="24,18,24,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <VerticalStackLayout Spacing="2">
                <Label Text="WEIGHIN" FontSize="10" CharacterSpacing="2.5" TextColor="#9397AB" />
                <Label x:Name="DashboardDateLabel" Text="Fri 28 August" FontSize="20" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
            </VerticalStackLayout>
            <Button x:Name="ThemeButton" Grid.Column="1" Text="☾" WidthRequest="36" HeightRequest="36" Padding="0" FontSize="18" TextColor="#9184D9" BackgroundColor="Transparent" Clicked="OnThemeClicked" />
            <Border Grid.Column="2" WidthRequest="36" HeightRequest="36" Stroke="#2C2F3D" BackgroundColor="#232532" StrokeShape="RoundRectangle 18">
                <Label Text="H" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="#E9E9ED" />
            </Border>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,10,24,28" Spacing="18">
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="18,18,18,16">
                    <VerticalStackLayout Spacing="6">
                        <GraphicsView x:Name="GaugeGraphic" HeightRequest="60" WidthRequest="240" HorizontalOptions="Center" />
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label Text="MORNING, HANNAH" FontSize="10" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            <Label x:Name="CurrentWeightLabel" Grid.Row="1" Text="52.65" FontSize="44" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                            <Label x:Name="CurrentUnitLabel" Grid.Row="1" Grid.Column="1" Text="kg" FontSize="13" Margin="0,23,0,0" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            <Label x:Name="CurrentBmiLabel" Grid.Row="2" Text="BMI 17.6 · Underweight" FontSize="12" TextColor="#B5ABFC" />
                            <Label x:Name="BmiStandardLabel" Grid.Row="2" Grid.Column="1" Text="Asian standard" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" VerticalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SINCE LAST" FontSize="10" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            <Label x:Name="DeltaSinceLastLabel" Text="—" FontSize="18" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SINCE START" FontSize="10" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                            <Label x:Name="DeltaSinceStartLabel" Text="—" FontSize="18" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="7">
                    <VerticalStackLayout Spacing="6"><Label Text="22" HorizontalOptions="Center" TextColor="#75798C" /><Label Text="Sat" FontSize="11" HorizontalOptions="Center" TextColor="#9397AB" /><BoxView HeightRequest="4" Color="#CFD3E5" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="23" HorizontalOptions="Center" TextColor="#75798C" /><Label Text="Sun" FontSize="11" HorizontalOptions="Center" TextColor="#9397AB" /><BoxView HeightRequest="4" Color="#CFD3E5" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6"><Label Text="24" HorizontalOptions="Center" TextColor="#75798C" /><Label Text="Mon" FontSize="11" HorizontalOptions="Center" TextColor="#9397AB" /><BoxView HeightRequest="4" Color="#CFD3E5" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="6"><Label Text="25" HorizontalOptions="Center" TextColor="#75798C" /><Label Text="Tue" FontSize="11" HorizontalOptions="Center" TextColor="#9397AB" /><BoxView HeightRequest="4" Color="#CFD3E5" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4" Spacing="6"><Label Text="26" HorizontalOptions="Center" TextColor="#75798C" /><Label Text="Wed" FontSize="11" HorizontalOptions="Center" TextColor="#9397AB" /><BoxView HeightRequest="4" Color="#CFD3E5" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="5" Spacing="6"><Label Text="27" HorizontalOptions="Center" TextColor="#75798C" /><Label Text="Thu" FontSize="11" HorizontalOptions="Center" TextColor="#9397AB" /><BoxView HeightRequest="4" Color="#CFD3E5" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="6" Spacing="6"><Label Text="28" HorizontalOptions="Center" TextColor="#9184D9" /><Label Text="Today" FontSize="11" HorizontalOptions="Center" TextColor="#9184D9" /><BoxView HeightRequest="4" Color="#9184D9" /></VerticalStackLayout>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="LAST 30 DAYS" FontSize="11" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                        <Label x:Name="WeeklyRateLabel" Grid.Column="1" Text="—" FontSize="13" TextColor="{AppThemeBinding Light=#477361, Dark=#B5ABFC}" />
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="{AppThemeBinding Light=#E7E3DC, Dark=#2C2F3D}" Margin="0,14" />
                        <Label x:Name="TrendStartLabel" Grid.Row="2" Text="" FontSize="11" TextColor="{AppThemeBinding Light=#9C9990, Dark=#75798C}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Today" FontSize="11" TextColor="{AppThemeBinding Light=#9C9990, Dark=#75798C}" />
                        <GraphicsView x:Name="TrendGraph" Grid.Row="3" Grid.ColumnSpan="2" HeightRequest="54" Margin="0,2" />
                    </Grid>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#EEEAE0, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=Transparent, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="GOAL" FontSize="11" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#817D72, Dark=#9397AB}" />
                        <Label Grid.Column="1" Text="41%" FontSize="15" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" />
                        <Label Grid.Row="1" Text="68.0 kg by 1 Dec" FontSize="19" TextColor="{AppThemeBinding Light=#182C2B, Dark=#E9E9ED}" Margin="0,6,0,10" />
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="0.41" ProgressColor="#9184D9" BackgroundColor="{AppThemeBinding Light=#B7B4B0, Dark=#3F424D}" HeightRequest="7" />
                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="At this rate: about 19 Jan. Estimate only." FontSize="12" TextColor="{AppThemeBinding Light=#817D72, Dark=#75798C}" Margin="0,10,0,0" />
                    </Grid>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="26 WEEKS" FontSize="11" CharacterSpacing="1.2" TextColor="{AppThemeBinding Light=#888780, Dark=#9397AB}" />
                        <GraphicsView x:Name="ContributionGraphic" HeightRequest="80" />
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" BackgroundColor="Transparent" Color="{AppThemeBinding Light=#E4E1D8, Dark=#232532}" />
                            <Label Text="missed" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" VerticalOptions="Center" />
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" BackgroundColor="Transparent" Color="#8878D6" Margin="10,0,0,0" />
                            <Label Text="logged" FontSize="10" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"><VerticalStackLayout Spacing="5"><Label x:Name="WeeksTrackingLabel" Text="0 weeks" FontSize="20" TextColor="{AppThemeBinding Light=#183332, Dark=#E9E9ED}" /><Label Text="tracking" FontSize="12" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Stroke="{AppThemeBinding Light=#D8D6D1, Dark=#2C2F3D}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"><VerticalStackLayout Spacing="5"><Label x:Name="StreakLabel" Text="0 days" FontSize="20" TextColor="{AppThemeBinding Light=#183332, Dark=#E9E9ED}" /><Label Text="current streak" FontSize="12" TextColor="{AppThemeBinding Light=#8D8A82, Dark=#75798C}" /></VerticalStackLayout></Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1F2E}" Padding="12,14,12,20" ColumnDefinitions="*,*,76,*,*">
            <Grid HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="HomeIcon" WidthRequest="24" HeightRequest="24" />
                    <Label x:Name="HomeLabel" Text="Home" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="1" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="TrendsIcon" WidthRequest="24" HeightRequest="24" />
                    <Label x:Name="TrendsLabel" Text="Trends" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTrendsClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="3" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="CalendarIcon" WidthRequest="24" HeightRequest="24" />
                    <Label x:Name="CalendarLabel" Text="Calendar" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarClicked" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid Grid.Column="4" HeightRequest="56" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <GraphicsView x:Name="MoreIcon" WidthRequest="24" HeightRequest="24" />
                    <Label x:Name="MoreLabel" Text="More" FontSize="10" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreClicked" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>
        <Border Grid.Row="2" WidthRequest="64" HeightRequest="64" Margin="0,0,0,46" HorizontalOptions="Center" VerticalOptions="End" StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="#9184D9">
            <Border.Shadow>
                <Shadow Brush="#9184D9" Radius="18" Opacity="0.55" Offset="0,4" />
            </Border.Shadow>
            <GraphicsView x:Name="AddIcon" WidthRequest="64" HeightRequest="64" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddClicked" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>
