<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.OnboardingPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#161826">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,36,24,22">
        <HorizontalStackLayout x:Name="ProgressBarsStack" Grid.Row="0" Spacing="5" />
        <Label x:Name="StepLabel" Grid.Row="1" FontSize="10" CharacterSpacing="1.4" Margin="0,10,0,0" TextColor="#75798C" />

        <ScrollView Grid.Row="2">
            <Grid Margin="0,14,0,0">

                <!-- Step 0: Welcome -->
                <VerticalStackLayout x:Name="Step0Panel" Spacing="18" Padding="0,44,0,0">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Start">
                        <Image Source="weighin_logo.png" WidthRequest="52" HeightRequest="52" Aspect="AspectFit" HorizontalOptions="Start" />
                        <Image Source="weighin_logoname_trim.png" WidthRequest="88" HeightRequest="34" Aspect="AspectFit" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <Label Text="Weigh in once a day. That is the whole app." FontSize="32" LineBreakMode="WordWrap" TextColor="#E9E9ED" />
                    <Label Text="Two taps in the morning. A chart that tells you the truth about the week, not the day." FontSize="14" LineBreakMode="WordWrap" TextColor="#9397AB" />
                    <Label Text="🔒  No account. Nothing leaves the phone." FontSize="12" TextColor="#75798C" Margin="0,6,0,0" />
                </VerticalStackLayout>

                <!-- Step 1: About you -->
                <VerticalStackLayout x:Name="Step1Panel" Spacing="4" IsVisible="False">
                    <Label Text="About you" FontSize="26" TextColor="#E9E9ED" />
                    <Label Text="Height is only used to work out BMI." FontSize="13" TextColor="#9397AB" Margin="0,0,0,14" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="1" Stroke="#2C2F3D" StrokeShape="RoundRectangle 21" BackgroundColor="Transparent">
                            <Label Text="−" FontSize="21" TextColor="#E9E9ED" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeightDownTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="HeightValueLabel" FontSize="46" TextColor="#E9E9ED" />
                            <Label Text="cm" FontSize="16" VerticalOptions="End" Margin="0,0,0,6" TextColor="#9397AB" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeThickness="1" Stroke="#2C2F3D" StrokeShape="RoundRectangle 21" BackgroundColor="Transparent">
                            <Label Text="+" FontSize="21" TextColor="#E9E9ED" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeightUpTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="WEIGH IN" FontSize="10" CharacterSpacing="1.2" TextColor="#75798C" Margin="0,20,0,9" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border x:Name="KgUnitBorder" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                            <Label x:Name="KgUnitLabel" Text="kg" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnKgUnitTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" x:Name="LbUnitBorder" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="44">
                            <Label x:Name="LbUnitLabel" Text="lb" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLbUnitTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="BMI STANDARD" FontSize="10" CharacterSpacing="1.2" TextColor="#75798C" Margin="0,20,0,9" />
                    <VerticalStackLayout Spacing="8">
                        <Border x:Name="AsianStdBorder" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14,11">
                            <VerticalStackLayout Spacing="1">
                                <Label x:Name="AsianStdLabel" Text="Asian" FontSize="14" />
                                <Label Text="Common in Asian health guidelines" FontSize="11" Opacity="0.65" TextColor="#9397AB" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAsianStandardTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="GeneralStdBorder" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14,11">
                            <VerticalStackLayout Spacing="1">
                                <Label x:Name="GeneralStdLabel" Text="General / WHO" FontSize="14" />
                                <Label Text="Common in Western health guidelines" FontSize="11" Opacity="0.65" TextColor="#9397AB" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGeneralStandardTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Step 2: Today's weight -->
                <VerticalStackLayout x:Name="Step2Panel" Spacing="4" IsVisible="False">
                    <Label Text="Today's weight" FontSize="26" TextColor="#E9E9ED" />
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,16,0,2">
                        <Entry x:Name="TodayWeightEntry" Placeholder="0.0" Keyboard="Numeric" FontSize="46" WidthRequest="150" HorizontalTextAlignment="Center" TextColor="#E9E9ED" TextChanged="OnTodayWeightChanged" />
                        <Label x:Name="TodayWeightUnitLabel" Text="kg" FontSize="17" VerticalOptions="End" Margin="0,0,0,10" TextColor="#9397AB" />
                    </HorizontalStackLayout>
                    <Label x:Name="TodayBmiLabel" FontSize="12" HorizontalOptions="Center" MinimumHeightRequest="17" />
                </VerticalStackLayout>

                <!-- Step 3: Goal -->
                <VerticalStackLayout x:Name="Step3Panel" Spacing="4" IsVisible="False">
                    <Label Text="Where are you headed?" FontSize="26" TextColor="#E9E9ED" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="1" Stroke="#2C2F3D" StrokeShape="RoundRectangle 21" BackgroundColor="Transparent">
                            <Label Text="−" FontSize="21" TextColor="#E9E9ED" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoalDownTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <HorizontalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="GoalValueLabel" FontSize="46" TextColor="#E9E9ED" />
                            <Label x:Name="GoalUnitLabel" Text="kg" FontSize="16" VerticalOptions="End" Margin="0,0,0,6" TextColor="#9397AB" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeThickness="1" Stroke="#2C2F3D" StrokeShape="RoundRectangle 21" BackgroundColor="Transparent">
                            <Label Text="+" FontSize="21" TextColor="#E9E9ED" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoalUpTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                    <Label Text="BY WHEN" FontSize="10" CharacterSpacing="1.2" TextColor="#75798C" Margin="0,18,0,9" />
                    <Grid x:Name="WeeksOptionsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#231F3D" Padding="13,11" Margin="0,16,0,0">
                        <Label x:Name="GoalRateLabel" FontSize="12" LineBreakMode="WordWrap" TextColor="#E9E9ED" />
                    </Border>
                </VerticalStackLayout>

                <!-- Step 4: Reminder -->
                <VerticalStackLayout x:Name="Step4Panel" Spacing="4" IsVisible="False">
                    <Label Text="A nudge each morning" FontSize="26" TextColor="#E9E9ED" />
                    <Label Text="Weighing at the same time each day is what makes the trend readable." FontSize="13" LineBreakMode="WordWrap" TextColor="#9397AB" Margin="0,0,0,16" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#1D1F2E" Padding="15,13">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Daily reminder" FontSize="14" VerticalOptions="Center" TextColor="#E9E9ED" />
                            <Switch x:Name="ReminderSwitch" Grid.Column="1" Toggled="OnReminderToggled" OnColor="#9184D9" />
                        </Grid>
                    </Border>
                    <Grid x:Name="ReminderTimesGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="7" Margin="0,14,0,0" />
                </VerticalStackLayout>

                <!-- Step 5: Lock -->
                <VerticalStackLayout x:Name="Step5Panel" Spacing="4" IsVisible="False">
                    <Label Text="Lock the app" FontSize="26" TextColor="#E9E9ED" />
                    <Label x:Name="PinInstructionLabel" Text="Choose a 4-digit PIN." FontSize="13" TextColor="#9397AB" Margin="0,0,0,4" />
                    <HorizontalStackLayout Spacing="28" HorizontalOptions="Center" Margin="0,14,0,0">
                        <HorizontalStackLayout x:Name="PinDotsStack" Spacing="11" />
                        <HorizontalStackLayout x:Name="ConfirmDotsStack" Spacing="11" />
                    </HorizontalStackLayout>
                    <Label x:Name="PinMismatchLabel" Text="" FontSize="11" TextColor="#E0A08C" HorizontalOptions="Center" Margin="0,10,0,0" />
                    <Grid x:Name="PinKeypadGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,16,0,0" />
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16" Margin="0,14,0,0">
            <Label x:Name="BackLabel" Text="Back" FontSize="13" VerticalOptions="Center" TextColor="#9397AB" IsVisible="False">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" x:Name="SkipLabel" Text="Skip" FontSize="13" VerticalOptions="Center" TextColor="#9397AB" IsVisible="False">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSkipTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Button Grid.Column="2" x:Name="NextButton" Text="Get started" Clicked="OnNextClicked" BackgroundColor="#9184D9" TextColor="#161826" CornerRadius="10" HeightRequest="48" />
        </Grid>
    </Grid>
</ContentPage>
