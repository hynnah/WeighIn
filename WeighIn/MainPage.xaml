<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeighIn.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F6F4EE">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="24,18,24,8" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="WEIGHIN" FontSize="12" CharacterSpacing="3" TextColor="#7A776F" FontAttributes="Bold" />
                <Label Text="Fri 28 August" FontSize="22" FontAttributes="Bold" TextColor="#22231F" />
            </VerticalStackLayout>
            <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" StrokeThickness="0" BackgroundColor="#E3DED3" StrokeShape="RoundRectangle 21">
                <Label Text="H" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" TextColor="#34342F" />
            </Border>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,10,24,28" Spacing="18">
                <Border BackgroundColor="#283B35" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="22,22,22,20">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="MORNING, HANNAH" FontSize="11" CharacterSpacing="1.5" TextColor="#B9C9BC" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="71.6" FontSize="58" FontAttributes="Bold" TextColor="#F4F0E8" />
                        <Label Grid.Row="1" Grid.Column="1" Text="kg" FontSize="17" Margin="0,27,0,0" TextColor="#B9C9BC" />
                        <Label Grid.Row="2" Text="BMI 24.2  ·  Overweight" FontSize="14" TextColor="#F0B878" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Asian standard" FontSize="11" TextColor="#B9C9BC" VerticalOptions="End" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="7">
                    <VerticalStackLayout Spacing="6"><Label Text="22" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#77766F" /><Label Text="Sat" FontSize="11" HorizontalOptions="Center" TextColor="#97948C" /><BoxView HeightRequest="4" Color="#CAD1C6" CornerRadius="2" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="23" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#77766F" /><Label Text="Sun" FontSize="11" HorizontalOptions="Center" TextColor="#97948C" /><BoxView HeightRequest="4" Color="#CAD1C6" CornerRadius="2" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6"><Label Text="24" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#77766F" /><Label Text="Mon" FontSize="11" HorizontalOptions="Center" TextColor="#97948C" /><BoxView HeightRequest="4" Color="#CAD1C6" CornerRadius="2" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="6"><Label Text="25" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#77766F" /><Label Text="Tue" FontSize="11" HorizontalOptions="Center" TextColor="#97948C" /><BoxView HeightRequest="4" Color="#CAD1C6" CornerRadius="2" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4" Spacing="6"><Label Text="26" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#77766F" /><Label Text="Wed" FontSize="11" HorizontalOptions="Center" TextColor="#97948C" /><BoxView HeightRequest="4" Color="#CAD1C6" CornerRadius="2" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="5" Spacing="6"><Label Text="27" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#77766F" /><Label Text="Thu" FontSize="11" HorizontalOptions="Center" TextColor="#97948C" /><BoxView HeightRequest="4" Color="#CAD1C6" CornerRadius="2" /></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="6" Spacing="6"><Label Text="28" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#283B35" /><Label Text="Today" FontSize="11" HorizontalOptions="Center" TextColor="#283B35" FontAttributes="Bold" /><BoxView HeightRequest="4" Color="#E29A5F" CornerRadius="2" /></VerticalStackLayout>
                </Grid>
                <Border BackgroundColor="#FFFFFF" Stroke="#E6E2D9" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="LAST 30 DAYS" FontSize="11" CharacterSpacing="1.2" TextColor="#8D8A82" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="−0.2 kg / week" FontSize="13" TextColor="#477361" FontAttributes="Bold" />
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="#EFEBE2" Margin="0,14" />
                        <Label Grid.Row="2" Text="31 Jul" FontSize="11" TextColor="#9C9990" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Today" FontSize="11" TextColor="#9C9990" />
                        <GraphicsView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="82" Margin="0,2" Drawable="{x:Null}" />
                    </Grid>
                </Border>
                <Border BackgroundColor="#EEE9DD" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18,16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Text="GOAL" FontSize="11" CharacterSpacing="1.2" TextColor="#817D72" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="41%" FontSize="15" TextColor="#283B35" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="68.0 kg by 1 Dec" FontSize="19" FontAttributes="Bold" TextColor="#283B35" Margin="0,6,0,10" />
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="0.41" ProgressColor="#E29A5F" BackgroundColor="#D9D2C4" HeightRequest="7" />
                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="At this rate: about 19 Jan. Estimate only." FontSize="12" TextColor="#817D72" Margin="0,10,0,0" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="#FFFFFF" Stroke="#E6E2D9" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"><VerticalStackLayout Spacing="5"><Label Text="26 weeks" FontSize="20" FontAttributes="Bold" TextColor="#283B35" /><Label Text="tracking" FontSize="12" TextColor="#8D8A82" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E6E2D9" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16"><VerticalStackLayout Spacing="5"><Label Text="5 days" FontSize="20" FontAttributes="Bold" TextColor="#283B35" /><Label Text="current streak" FontSize="12" TextColor="#8D8A82" /></VerticalStackLayout></Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="#FBFAF6" Padding="18,12,18,20" ColumnDefinitions="*,*,*,*,Auto">
            <Button Text="⌂" FontSize="25" TextColor="#283B35" BackgroundColor="Transparent" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="⌁" FontSize="26" TextColor="#98958C" BackgroundColor="Transparent" Clicked="OnTrendsClicked" />
            <Button Grid.Column="2" Text="＋" FontSize="30" TextColor="#E29A5F" BackgroundColor="Transparent" Clicked="OnAddClicked" />
            <Button Grid.Column="3" Text="□" FontSize="24" TextColor="#98958C" BackgroundColor="Transparent" Clicked="OnCalendarClicked" />
            <Button Grid.Column="4" Text="•••" FontSize="18" TextColor="#98958C" BackgroundColor="Transparent" Clicked="OnMoreClicked" />
        </Grid>
    </Grid>
</ContentPage>
